#!/bin/bash
set -e
trap 'rc=$?; echo "[JOB][ERROR] line=$LINENO rc=$rc cmd=${BASH_COMMAND}"; exit $rc' ERR

echo "=== PDHD decon + michelt0 job starting ==="
echo "Host: $(hostname)"
echo "PWD:  $(pwd)"

# ---- More detailed setup diagnostics (pinpoint failures) ----
DUNE_VERSION=${DUNE_VERSION:-v10_17_00d00}
DUNE_QUALIFIER=${DUNE_QUALIFIER:-e26:prof}

echo "[JOB] Shell: $0  BASH_VERSION=${BASH_VERSION:-NA}"
echo "[JOB] CVMFS dune:    $(ls -ld /cvmfs/dune.opensciencegrid.org/products/dune 2>/dev/null || echo NO)"
echo "[JOB] CVMFS larsoft: $(ls -ld /cvmfs/larsoft.opensciencegrid.org/products 2>/dev/null || echo NO)"

echo "[JOB] Step B1: before setup_dune.sh"
export _underscore="${_underscore:-_}"

# UPS/products bootstrap first
source /cvmfs/larsoft.opensciencegrid.org/products/setup

set +e
source /cvmfs/dune.opensciencegrid.org/products/dune/setup_dune.sh
rc=$?
set -e
echo "[JOB] Step B1: after setup_dune.sh (rc=${rc})"
if [ ${rc} -ne 0 ]; then
    echo "[JOB] WARNING: setup_dune.sh returned non-zero; continuing for diagnosis."
fi

echo "[JOB] Step B2: check 'setup' command"
type setup
echo "[JOB] Step B2: done"

echo "[JOB] Step C1: before setup dunesw ${DUNE_VERSION} -q ${DUNE_QUALIFIER}"
set +e
setup dunesw "${DUNE_VERSION}" -q "${DUNE_QUALIFIER}"
rc=$?
set -e
echo "[JOB] Step C1: after setup dunesw (rc=${rc})"
if [ ${rc} -ne 0 ]; then
    echo "[JOB][FATAL] setup dunesw failed."
    exit 3
fi

echo "[JOB] Step C2: check lar"
command -v lar || { echo "[JOB][FATAL] lar not found on PATH after setup dunesw"; exit 4; }
lar --version || lar -v || true
echo "[JOB] Step C2: done"






# ------------------------------------------------------------
# Config (defaults)
# ------------------------------------------------------------



echo "Workflow: w${JUSTIN_WORKFLOW_ID:-?} s${JUSTIN_STAGE_ID:-?} jobsub=${JUSTIN_JOBSUB_ID:-?}"
echo "Using: DECON_FCL=${DECON_FCL}  MICHEL_FCL=${MICHEL_FCL}"
echo "Using: dunesw ${DUNE_VERSION} -q ${DUNE_QUALIFIER}"

# ------------------------------------------------------------
# 1) Get one unprocessed file from justIN
# ------------------------------------------------------------
did_pfn_rse="$("$JUSTIN_PATH/justin-get-file")" || true
if [ -z "${did_pfn_rse}" ]; then
    echo "Nothing to process - exiting cleanly."
    exit 0
fi

did="$(echo "${did_pfn_rse}" | cut -f1 -d' ')"
pfn="$(echo "${did_pfn_rse}" | cut -f2 -d' ')"
rse="$(echo "${did_pfn_rse}" | cut -f3 -d' ')"

echo "Input DID: ${did}"
echo "Input PFN: ${pfn}"
echo "Input RSE: ${rse}"

# Keep DID record (useful if you later want metadata mapping)
echo "${did}" >> all-input-dids.txt



# Thread knobs (optional; harmless)
export TF_NUM_THREADS=${JUSTIN_PROCESSORS:-1}
export OPENBLAS_NUM_THREADS=${JUSTIN_PROCESSORS:-1}
export OMP_NUM_THREADS=${JUSTIN_PROCESSORS:-1}

# ------------------------------------------------------------
# 3) Construct output name from input file name (your style)
# ------------------------------------------------------------
base="$(basename "${pfn}")"
extracted="$(echo "${base}" | awk -F'_' '{print $3"_"$4"_"$5"_"$6"_"$7"_"$8}')"
out="michelt0_decon_${extracted}.root"

echo "base=${base}"
echo "extracted=${extracted}"
echo "final_out=${out}"

# ------------------------------------------------------------
# 4) Clean workspace (retry-safe)
# ------------------------------------------------------------
rm -f input.root deconv_gen.root michelt0_Decon.root "${out}" *.log

# ------------------------------------------------------------
# 5) Stage input locally (more robust than streaming for heavy I/O)
#    If you prefer streaming, tell me and I’ll switch to LD_PRELOAD style.
# ------------------------------------------------------------
echo "Staging input via xrdcp..."
xrdcp -f "${pfn}" input.root

# ------------------------------------------------------------
# 6) Run Step 1 + Step 2, capture logs (like official example)
# ------------------------------------------------------------
now="$(date -u +"%Y%m%dT%H%M%SZ")"
log1="decon_${extracted}_${now}.log"
log2="michelt0_${extracted}_${now}.log"

echo "Running deconvolution..."
lar -c "${DECON_FCL}" -s input.root > "${log1}" 2>&1
echo "Deconvolution finished, checking deconv_gen.root..."
test -f deconv_gen.root

echo "Running michel timing..."
lar -c "${MICHEL_FCL}" -s deconv_gen.root > "${log2}" 2>&1
echo "Michel timing finished, checking michelt0_Decon.root..."
test -f michelt0_Decon.root

# Rename for upload
mv -f michelt0_Decon.root "${out}"

# Mark PFN processed for justIN
echo "${pfn}" > justin-processed-pfns.txt

echo "=== Tail of logs ==="
echo "--- ${log1} (last 50 lines) ---"
tail -50 "${log1}" || true
echo "--- ${log2} (last 50 lines) ---"
tail -50 "${log2}" || true

# Bundle logs like the official example
tar zcf "$(echo "${JUSTIN_JOBSUB_ID:-job}.logs.tgz" | sed 's/@/_/g')" *.log || true

echo "=== Final directory listing ==="
ls -lh
exit 0