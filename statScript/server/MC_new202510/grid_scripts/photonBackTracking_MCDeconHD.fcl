#include "services_dune.fcl"
#include "protodune_tools_dune.fcl"

process_name: MichelTime

services:
{
  #Load the service that manages root files for histograms.
  TFileService: { fileName: "michelt0_Decon.root" }
  TimeTracker:       {}
  MemoryTracker:         { }     #default is one
  RandomNumberGenerator: {}      #ART native random number generator
#                @table::protodune_data_reco_services
  @table::protodunehd_reco_services

  #Added by Shu, 20241111---
  Geometry:     @local::protodunehdv6_geo


  # ---- Add these for truth matching ------------------------------------------
  # ============================================================
  # REQUIRED for TrackID -> MCParticle mapping
  # (BackTrackerService looks specifically for "ParticleInventory")
  # ============================================================
  ParticleInventory: {
    service_type: "ParticleInventoryService"
  }

  # ============================================================
  # BackTracker service (constructs PhotonBackTracker internally)
  # You must provide Delay (no default in PhotonBackTracker.cc)
  # ============================================================
  BackTracker: {
    service_type: "BackTrackerService"

    # ---- these keys are read by PhotonBackTracker.cc ----
    Delay: 0.0                         # you MUST set this (units typically ns)
    G4ModuleLabel: "largeant"          # default is "largeant"
    # G4ModuleLabels: [ "largeant" ]   # optional alternative style
    OpHitLabel: "ophit"                # default; adjust if you run ophitspe
    OpFlashLabel: "opflash"            # default
    MinimumOpHitEnergyFraction: 0.1    # default
  }
  #----------------------------------------------------------------------------


  message:      @local::standard_info
  IFDH: {}
}

#load the geometry; Shu; 20241111---
#services.Geometry.GDML: "protodunehd_v6_refactored.gdml"
#services.Geometry.Name: "protodunehd_v6_refactored"
#services.Geometry.ROOT: "protodunehd_v6_refactored.gdml"

services.AuxDetGeometry.GDML: "protodunehd_v6_refactored.gdml"
services.AuxDetGeometry.Name: "protodunehdv6"


#source is now a root file
source:
{
  module_type: RootInput
  maxEvents:  1000           # Number of events to create
}

outputs:
{
}

physics:
{
 analyzers:{}
 
 ana:  [ t0 ]
# ana: []
 
 
 stream1:  [  ]

 trigger_paths: [] 

 #end_paths:     [ stream1, ana ] 
 end_paths:     [  ana ] 
}


physics.analyzers.t0:  {
    module_type:          "MichelTimingMcDeconHD"
}



