BEGIN_PROLOG

# =====================================================================
# Cosmic-like SingleGen for ProtoDUNE-HD
#  - 84 mu+ and 70 mu- per event (set by PDG list length)
#  - Downward-going cosmics (+y is upward -> py < 0)
#  - Energy: 0.3 to 3 GeV (Gaussian)
#  - Starting plane: y = +900 cm above detector
# =====================================================================

MuonGun: {
  module_type: "SingleGen"

  # ------------------------------------------------------------
  # SingleGen required configuration
  # ------------------------------------------------------------
  ParticleSelectionMode: "all"     # use entire PDG list every event
  PadOutVectors: true              # allow 1-entry vectors to be padded
  PDist: "Gaussian"
  PosDist: "uniform"
  TDist: "uniform"
  AngleDist: "Gaussian"

  # ------------------------------------------------------------
  # PDG list defines N_particles = 154
  # ------------------------------------------------------------
  PDG: [
    # 84 mu+
    -13, -13, -13, -13, -13, -13, -13, -13, -13, -13,
    -13, -13, -13, -13, -13, -13, -13, -13, -13, -13,
    -13, -13, -13, -13, -13, -13, -13, -13, -13, -13,
    -13, -13, -13, -13, -13, -13, -13, -13, -13, -13,
    -13, -13, -13, -13, -13, -13, -13, -13, -13, -13,
    -13, -13, -13, -13, -13, -13, -13, -13, -13, -13,
    -13, -13, -13, -13, -13, -13, -13, -13, -13, -13,
    -13, -13, -13, -13,

    # 70 mu-
    13, 13, 13, 13, 13, 13, 13, 13, 13, 13,
    13, 13, 13, 13, 13, 13, 13, 13, 13, 13,
    13, 13, 13, 13, 13, 13, 13, 13, 13, 13,
    13, 13, 13, 13, 13, 13, 13, 13, 13, 13,
    13, 13, 13, 13, 13, 13, 13, 13, 13, 13,
    13, 13, 13, 13, 13, 13, 13, 13, 13, 13
  ]

  # ------------------------------------------------------------
  # Momentum distribution (GeV/c)
  # ------------------------------------------------------------
  P0:      [ 1.0 ]
  SigmaP:  [ 0.7 ]

  # ------------------------------------------------------------
  # Starting positions (cm)
  # ------------------------------------------------------------
  X0:      [ 0.0 ]
  SigmaX:  [ 400.0 ]

  Y0:      [ 900.0 ]      # above detector
  SigmaY:  [ 5.0 ]

  Z0:      [ 230.0 ]
  SigmaZ:  [ 400.0 ]

  # ------------------------------------------------------------
  # Time (required by SingleGen)
  # ------------------------------------------------------------
  T0:      [ 0.0 ]
  SigmaT:  [ 0.0 ]

  # ------------------------------------------------------------
  # Angular distributions (degrees)
  #
  # From SingleGen code:
  #    px = p*cos(thetaYZ)*sin(thetaXZ)
  #    py = p*sin(thetaYZ)
  #    pz = p*cos(thetaXZ)*cos(thetaYZ)
  #
  # Downward cosmics require py < 0 -> thetaYZ = -90 deg
  # ------------------------------------------------------------
  AngleDist:    "Gaussian"
  Theta0XZ:     [ 0.0 ]
  SigmaThetaXZ: [ 180.0 ]

  Theta0YZ:     [ -90.0 ]
  SigmaThetaYZ: [ 25.0 ]

}

END_PROLOG
